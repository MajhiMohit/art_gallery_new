# ── Production (Vercel build) ─────────────────────────────────────────────────
# Vite automatically uses this file when building for production (vite build).
# The proxy in vite.config.js only runs during local dev — in production the
# frontend must call the Railway backend URL directly.
VITE_API_URL=https://artgallerybackendd-production.up.railway.app/api

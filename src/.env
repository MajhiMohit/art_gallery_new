# ── Development ──────────────────────────────────────────────
# Vite proxy forwards /api/* → http://localhost:8080/api/*
VITE_API_URL=/api

# ── Production (Vercel) ───────────────────────────────────────
# Override VITE_API_URL in Vercel dashboard with your Railway URL:
# VITE_API_URL=https://your-app.up.railway.app/api